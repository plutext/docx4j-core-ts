{
  "name": "@docx4j/core-ts",
  "version": "0.1.3",
  "description": "docx4j-core for TypeScript: Open Packaging (docx/pptx/xlsx zip and flat OPC), typed parts and relationships, style, numbering and font resolution over @docx4j/generated-objects-ts. Node, browsers, Word add-ins.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./opc": {
      "types": "./dist/opc/index.d.mts",
      "import": "./dist/opc/index.mjs"
    },
    "./parts": {
      "types": "./dist/parts/index.d.mts",
      "import": "./dist/parts/index.mjs"
    },
    "./packages": {
      "types": "./dist/packages/index.d.mts",
      "import": "./dist/packages/index.mjs"
    },
    "./model": {
      "types": "./dist/model/index.d.mts",
      "import": "./dist/model/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./office-js": {
      "types": "./dist/office-js/index.d.mts",
      "import": "./dist/office-js/index.mjs"
    },
    "./xpath-fonto": {
      "types": "./dist/model/customxml/xpath-fonto.d.mts",
      "import": "./dist/model/customxml/xpath-fonto.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate-supported.mjs",
    "build": "tsc -p tsconfig.build.json",
    "generate:fonts": "node scripts/generate-substitutions.mjs",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:examples",
    "typecheck:examples": "npm run build && tsc -p examples/office-addin/tsconfig.json",
    "pretest": "node scripts/generate-supported.mjs",
    "test": "npm run build && tsc -p test/nodenext/tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "docx4j",
    "ooxml",
    "openxml",
    "office open xml",
    "docx",
    "pptx",
    "xlsx",
    "opc",
    "wordprocessingml",
    "office-js",
    "word-addin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutext/docx4j-core-ts.git"
  },
  "homepage": "https://github.com/plutext/docx4j-core-ts",
  "bugs": {
    "url": "https://github.com/plutext/docx4j-core-ts/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@docx4j/generated-objects-ts": "^0.2.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "fontoxpath": "^3.34.0",
    "typescript": "~5.6.3",
    "xpath": "^0.0.34"
  },
  "peerDependencies": {
    "fontoxpath": "^3.30.0",
    "xpath": "^0.0.34"
  },
  "peerDependenciesMeta": {
    "fontoxpath": {
      "optional": true
    },
    "xpath": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
