// CR-012 section 24: the capitals Word shows for w:caps (WD REQ-607), docx4j's org.docx4j.model.text.CaseMapping
// (its CR-069 phase 1, released in 17.3.5).
import { CASE_MAPPING_UNICODE_VERSION, UPPERCASE_RUNS } from './caseMapping.generated.mjs';
import type { TextOptions } from './TextOptions.mjs';
import { TextBlock, TextComment, TextRun } from './TextResult.mjs';

/** The language where a run, its styles, the document defaults and `w:themeFontLang` name none: docx4j's documented default (REQ-607 leaves it to the implementation). */
const DEFAULT_LANGUAGE = 'en-US';

/** The code point's simple uppercase mapping, by binary search over the generated runs; itself where it has none. */
function upperOf(cp: number): number {
  let lo = 0;
  let hi = UPPERCASE_RUNS.length / 4 - 1;
  while (lo <= hi) {
    const mid = (lo + hi) >> 1;
    const start = UPPERCASE_RUNS[mid * 4]!;
    if (cp < start) {
      hi = mid - 1;
    } else if (cp > UPPERCASE_RUNS[mid * 4 + 1]!) {
      lo = mid + 1;
    } else {
      return (cp - start) % UPPERCASE_RUNS[mid * 4 + 3]! === 0 ? cp + UPPERCASE_RUNS[mid * 4 + 2]! : cp;
    }
  }
  return cp;
}

/**
 * The capitals Word shows for `w:caps`, written by the plain-text and Markdown writers (WD REQ-607; docx4j CR-069): each
 * code point mapped to its single uppercase code point (Unicode's simple mapping, Java's `Character.toUpperCase(int)`),
 * by the run's language, so that Turkish and Azeri `i` gives `İ` (U+0130); nothing expands, so `ß` stays `ß`, the
 * ligature `ﬁ` stays `ﬁ`, and `ǆ` gives `Ǆ`, not the titlecase `ǅ`. Measured in Word for Microsoft 365 on 31 October 2026
 * (docx4j's `caps-lang` probes, `test/text-extraction/suite/dpp/caps/`). Not `toUpperCase()` or `toLocaleUpperCase()`,
 * whose full mapping expands `ß` to `SS` and `ﬁ` to `FI`, which Word does not.
 *
 * A small-caps run is written as its stored characters, unless `small_caps: upper` is set, when it is mapped as a caps run
 * is. The block model keeps the stored characters (`TextRun.text`), so that addresses, offsets and `officeOffset` refer to
 * them; the mapping is the writers', and it keeps the length, in code points and in UTF-16 units.
 *
 * The Unicode version is 15.0 (`UNICODE_VERSION`), the version docx4j's tests run (JDK 21), from a table generated by
 * `scripts/generate-case-mapping.mjs` (CR-012 section 24.1, D4), never the runtime's: Node's ICU is a later Unicode,
 * whose simple mapping JavaScript doesn't expose, and which differs across Node versions. A case pair added after 15.0 is
 * left unmapped, U+1C8A (Unicode 16.0) for one, as WD 0.52's REQ-607 has it. docx4j `CaseMapping`.
 */
export const CaseMapping = {
  /** The language of last resort (docx4j `DEFAULT_LANGUAGE`). */
  DEFAULT_LANGUAGE,

  /** The Unicode version of the mapping. */
  UNICODE_VERSION: CASE_MAPPING_UNICODE_VERSION,

  /**
   * A text in capitals by a language (`w:lang/@w:val`, a BCP 47 tag such as `tr-TR`; undefined for `DEFAULT_LANGUAGE`):
   * each code point to its single uppercase code point, `i` to `İ` where the language is Turkish or Azeri. A code point
   * whose uppercase would change its length in UTF-16 is kept (none at 15.0; the generator leaves such a pair out).
   */
  upper(text: string, language?: string): string {
    if (text === '') return text;
    const dotted = dottedI(language);
    let out = '';
    for (const ch of text) {
      const cp = ch.codePointAt(0)!;
      out += String.fromCodePoint(dotted && cp === 0x69 ? 0x130 : upperOf(cp));
    }
    return out;
  },

  /** Whether a writer writes a run in capitals: a caps run, or a small-caps one under `small_caps: upper`. */
  isUpper(run: TextRun, options: TextOptions | undefined): boolean {
    return run.caps || (run.smallCaps && options?.smallCaps === 'upper');
  },

  /**
   * As the writers write it: a run's stored text, in capitals where `isUpper`; a block's text (`TextBlock.text`) with each
   * run's so; a comment's text (`TextComment.text`), its blocks a line apart, each so.
   */
  written(item: TextRun | TextBlock | TextComment, options: TextOptions | undefined): string {
    if (item instanceof TextRun) return CaseMapping.isUpper(item, options) ? CaseMapping.upper(item.text, item.language) : item.text;
    if (item instanceof TextBlock) return item.textWith((r) => CaseMapping.written(r, options));
    return item.blocks.map((b) => CaseMapping.written(b, options)).join('\n');
  },
};

/** Whether a language's capital of `i` is the dotted `İ`: Turkish and Azeri, as Java's own casing has it. */
function dottedI(language: string | undefined): boolean {
  if (language === undefined) return false;
  const primary = language.trim().split(/[-_]/, 1)[0]!.toLowerCase();
  return primary === 'tr' || primary === 'az';
}
